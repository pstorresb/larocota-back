NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://larocota:change-me@127.0.0.1:5432/larocota
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=larocota_session
SESSION_TTL_HOURS=168
UPLOAD_DIR=./media
MAX_UPLOAD_BYTES=8388608
LOG_LEVEL=info
SEED_SUPERADMIN_EMAIL=admin@larocota.com
SEED_SUPERADMIN_PASSWORD=replace-with-a-long-random-password
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
RESEND_API_KEY=re_pon_tu_api_key
EMAIL_FROM=La Rocota <cuenta@larocota.com>
# Detrás de nginx: confiar en X-Forwarded-For para que los límites de peticiones sean por cliente. "false" solo si la API se expone directamente.
TRUST_PROXY=true
# Horas que tiene el cliente para subir el comprobante antes de que el pedido se cancele y libere cupos.
PAYMENT_WINDOW_HOURS=24
# Segundos entre corridas del mantenimiento (abrir/cerrar ciclos, expirar reservas, purgar). 0 lo desactiva.
MAINTENANCE_INTERVAL_SECONDS=60
