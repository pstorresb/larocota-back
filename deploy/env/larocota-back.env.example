NODE_ENV=production
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://larocota:REEMPLAZAR@127.0.0.1:5432/larocota
FRONTEND_ORIGIN=https://larocota.com
SESSION_COOKIE_NAME=larocota_session
SESSION_TTL_HOURS=168
UPLOAD_DIR=/var/lib/larocota/uploads
MAX_UPLOAD_BYTES=8388608
LOG_LEVEL=info

# Correo transaccional (verificación de registro, recuperación de contraseña, estados de pedido).
# Sin RESEND_API_KEY el registro y la recuperación responden 503 EMAIL_UNAVAILABLE.
RESEND_API_KEY=REEMPLAZAR
EMAIL_FROM=La Rocota <cuenta@larocota.com>

# Acceso con Google (OIDC). Sin estos valores GET /api/v1/auth/google responde 503 GOOGLE_AUTH_UNAVAILABLE.
GOOGLE_CLIENT_ID=REEMPLAZAR.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REEMPLAZAR
GOOGLE_REDIRECT_URI=https://larocota.com/api/v1/auth/google/callback

# Solo para `npm run seed` (crea o actualiza el superadministrador). Mínimo 14 caracteres.
SEED_SUPERADMIN_EMAIL=admin@larocota.com
SEED_SUPERADMIN_PASSWORD=REEMPLAZAR

# Detrás de nginx: confiar en X-Forwarded-For para que los límites de peticiones sean por cliente.
TRUST_PROXY=true
# Horas que tiene el cliente para subir el comprobante antes de que el pedido se cancele y libere cupos.
PAYMENT_WINDOW_HOURS=24
# Segundos entre corridas del mantenimiento (abrir/cerrar ciclos, expirar reservas, purgar). 0 lo desactiva.
MAINTENANCE_INTERVAL_SECONDS=60
